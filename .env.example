NEXT_PUBLIC_SERVER_URL=https://www.example.com

# PostgreSQL connection used by Payload CMS
POSTGRES_PASSWORD=replace-with-a-unique-local-db-password
DATABASE_URI=postgresql://postgres:replace-with-a-unique-local-db-password@127.0.0.1:5432/modern_news_portal

# Replace with a unique random secret before deploying
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters

NEXT_PUBLIC_SITE_NAME=Modern News Portal
NEXT_PUBLIC_SITE_DESCRIPTION=Portal berita modern, terpercaya, dan independen.